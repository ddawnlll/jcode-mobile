{
  "name": "jcode-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "index.tsx",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bunx --bun expo start --dev-client",
    "ios": "bunx --bun expo run:ios",
    "android": "bunx --bun expo run:android",
    "prebuild": "bunx --bun expo prebuild",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint .",
    "test": "bun --bun jest --ci",
    "test:watch": "bun --bun jest --watch",
    "e2e": "bash scripts/run-e2e.sh",
    "e2e:headed": "bash scripts/run-e2e.sh --headed",
    "e2e:report": "bunx --bun playwright show-report .staging/e2e/report",
    "marketing:build": "bun --bun scripts/marketing/build.mjs",
    "marketing:serve": "bun --bun scripts/marketing/serve.mjs",
    "marketing:test": "bun run marketing:build && bun test scripts/marketing/*.test.mjs && bunx --bun playwright test -c e2e/marketing/playwright.config.ts",
    "web": "bunx --bun expo start --web",
    "web:export": "bunx --bun expo export -p web",
    "web:serve": "bun --bun scripts/serve-web.mjs dist/web",
    "adapter": "bun --bun integration/jcode-adapter/src/main.ts",
    "adapter:test": "bun test integration/jcode-adapter/test/*.test.ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "build:android:release": "bash scripts/build-android-release.sh",
    "build:ios:simulator": "bash scripts/build-ios-simulator.sh",
    "postinstall": "bun --bun scripts/patch-expo-modules-jsi.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "highlight.js": "11.11.1",
    "markdown-it": "14.1.0",
    "markdown-it-footnote": "4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "14.1.2",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "typescript": "~6.0.3",
    "ws": "^8.22.1"
  },
  "jest": {
    "preset": "jest-expo",
    "maxWorkers": 2,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/scripts/marketing/",
      "/.staging/",
      "/integration/",
      "/ios/",
      "/android/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|expo-.*|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|react-native-gesture-handler|react-native-reanimated|zustand))"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
