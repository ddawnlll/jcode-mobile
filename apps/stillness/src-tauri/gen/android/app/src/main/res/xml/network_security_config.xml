<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release builds must pair with the local Adapter v2 over http on the
         loopback interface. Cleartext is permitted for loopback targets only;
         every other target still requires TLS or the platform default. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
