<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release: cleartext only to a real loopback host.
         10.0.2.2 is the emulator alias for the host machine and is allowed by
         the debug-only override in src/debug/res/xml/network_security_config.xml. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">::1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
